      <column caption='Time Period Split ' datatype='string' name='[Calculation_373235871244259329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [date] &lt; #2016-09-01# THEN &quot;Before Sep 2016&quot;&#13;&#10;ELSE &quot;After Sep 2016&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_373235871261704194]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Day Date' datatype='datetime' name='[Calculation_373235871273160712]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[date])' />
      </column>
      <column caption='Sales per Day' datatype='real' name='[Calculation_373235871273529353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_373235871273160712] : SUM([sale.dollars])}' />
      </column>
      <column caption='Rank Sales' datatype='integer' name='[Calculation_373235871277584394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([sale.dollars]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
